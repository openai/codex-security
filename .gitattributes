*.cjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.mts text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

plugins/codex-security/scripts/dispatch_inventory_tool text eol=lf
plugins/codex-security/scripts/launch_codex_security_mcp text eol=lf

# Bundled dependencies contain intentional whitespace in strings and comments.
github-action/dist/*.cjs linguist-generated=true -whitespace

# git apply compares patch context with the LF sources installed by npm.
github-action/patches/*.patch text eol=lf

# This checksum-pinned upstream license contains its original whitespace.
docker/wolfi/payload/notices/BUBBLEWRAP-COPYING -text -whitespace
