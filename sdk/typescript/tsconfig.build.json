{
  "extends": "./tsconfig.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/retry-windows-rename.js",
    "src/scan-policy-catalog.json"
  ],
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "stripInternal": true,
    "sourceMap": true,
    "inlineSources": true,
    "noEmit": false,
    "incremental": false,
    "types": ["node"]
  }
}
