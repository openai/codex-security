{
  "name": "codex-security-action",
  "version": "0.9.2",
  "private": true,
  "type": "module",
  "description": "Run Codex Security in GitHub Actions with explicit scope, budgets, and scan health reporting",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.*",
    "test:cli": "node scripts/cli-integration.ts",
    "build": "node scripts/build.mjs",
    "check-dist": "node scripts/build.mjs --check",
    "check-metadata": "node scripts/check-metadata.ts",
    "docs": "node scripts/generate-input-docs.mjs",
    "check-docs": "node scripts/generate-input-docs.mjs --check",
    "validate": "npm run typecheck && npm test && npm run check-metadata && npm run check-docs && npm run check-dist",
    "pretest": "node scripts/apply-patches.mjs"
  },
  "dependencies": {
    "@actions/artifact": "6.3.1",
    "@actions/core": "3.0.1",
    "@actions/io": "3.0.2"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "overrides": {
    "archiver-utils@5": {
      "glob": "14.0.3"
    },
    "readdir-glob@1": {
      "minimatch": "11.0.2"
    }
  }
}
