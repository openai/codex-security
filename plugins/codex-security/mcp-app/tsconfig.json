{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@openai/codex-sdk": ["./node_modules/@openai/codex-sdk"],
      "smol-toml": ["./node_modules/smol-toml/dist/index"],
      "yauzl": ["./node_modules/@types/yauzl", "./node_modules/yauzl"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"],
    "lib": ["ES2024"],
    "allowImportingTsExtensions": true
  },
  "include": ["*.ts", "src", "tests/**/*.ts", "scripts/*.mts"]
}
