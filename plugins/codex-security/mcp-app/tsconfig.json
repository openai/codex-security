{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"],
    "lib": ["ESNext"],
    "allowImportingTsExtensions": true,
    "paths": {
      "#validation-runtime": [
        "../../../sdk/typescript/src/plugin-validation.ts",
        "./src/standalone-validation.ts"
      ]
    }
  },
  "include": ["*.ts", "src", "tests/**/*.ts", "scripts/*.mts"]
}
