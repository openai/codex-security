{
  "name": "codex-security-mcp-app",
  "version": "0.1.161",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/generate-artifact-schemas.mjs && tsc --noEmit",
    "build:mcp": "node scripts/build_mcp_app.mjs --output .preview/mcp",
    "test:mcp": "node --experimental-strip-types --test --test-concurrency=2 --test-reporter=./scripts/test_reporter.mts \"tests/test_*.ts\"",
    "typecheck": "node scripts/generate-artifact-schemas.mjs --check && tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@openai/codex-sdk": "0.166.0",
    "ajv": "8.20.0",
    "smol-toml": "1.9.1",
    "zod": "^4.6.7",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "prettier": "3.9.10",
    "typescript": "^7.0.2"
  }
}
